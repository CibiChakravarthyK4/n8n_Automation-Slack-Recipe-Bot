    {
      "parameters": {
        "jsCode": "// Get the raw text from the previous Basic LLM Chain node\nconst rawText = $json.text || \"\";\n\n// Replace literal \"\\n\" strings with actual newlines, then split by lines\nconst items = rawText\n  .replace(/\\\\n/g, '\\n')\n  .split('\\n')\n  .map(item => item.trim())\n  .filter(item => item.length > 0);\n\n// Format each item cleanly with a bullet point and ensure real line separation\nconst formattedList = items\n  .map(item => `• ${item.replace(/^[-*]\\s*/, '')}`)\n  .join('\\n');\n\n// Pass the formatted list forward to Slack\nreturn [{\n  json: {\n    formattedText: formattedList\n  }\n}];"
      },
